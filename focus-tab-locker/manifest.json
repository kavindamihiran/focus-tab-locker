{
  "manifest_version": 3,
  "name": "Focus Tab Locker",
  "version": "2.0",
  "description": "Stay focused by locking into one tab, with a safe countdown before returning.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Toggle Focus Mode"
  }
}
